[gd_scene format=3]

[ext_resource type="Script" path="res://ui/keep_row.gd" id="1"]

[node name="KeepRow" type="HBoxContainer"]
script = ExtResource("1")
theme_override_constants/separation = 2

[node name="Icon" type="TextureRect" parent="."]
custom_minimum_size = Vector2(16, 16)
mouse_filter = 2
size_flags_vertical = 4
stretch_mode = 3

[node name="Name" type="Label" parent="."]
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
clip_text = true

[node name="Count" type="Label" parent="."]
size_flags_vertical = 4
mouse_filter = 2
horizontal_alignment = 2
custom_minimum_size = Vector2(22, 0)

[node name="Minus" type="Button" parent="."]
text = "-"
tooltip_text = "Keep fewer: sell more"

[node name="Keep" type="Label" parent="."]
size_flags_vertical = 4
mouse_filter = 2
horizontal_alignment = 1
custom_minimum_size = Vector2(20, 0)

[node name="Plus" type="Button" parent="."]
text = "+"
tooltip_text = "Keep more: sell less"
